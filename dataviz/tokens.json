{
  "about": "GEM data visualization style values in one machine-readable file. STYLE.md explains them in words. The figure kit in shared/ reads this file at load time, so a change here changes every figure on its next export.",
  "checked": "2026-11-19",
  "sources": [
    "https://globalenergymonitor.org/data-visualization-style-guide",
    "https://observablehq.com/d/76aaf1373f5dfdab"
  ],
  "fonts": {
    "header": "Plus Jakarta Sans",
    "body": "Barlow Semi Condensed"
  },
  "text": {
    "color": "#3A4A50",
    "title": { "size": 28, "weight": 700, "lineHeight": 1.2 },
    "subtitle": { "size": 18, "weight": 400, "lineHeight": 1.45 },
    "body": { "size": 16, "weight": 400 },
    "footer": { "size": 14, "weight": 400, "lineHeight": 1.2 },
    "minimumSize": 14
  },
  "brand": {
    "midnight": "#002430",
    "navy": "#004A63",
    "teal": "#016B83",
    "orange": "#FE4F2D",
    "mint": "#A5E9E4",
    "warmWhite": "#F2F2EB",
    "white": "#FFFFFF"
  },
  "categorical": {
    "teal": "#016B83",
    "orange": "#FE4F2D",
    "indigo": "#4A57A8",
    "deepRed": "#7F142A",
    "green": "#65BD8B"
  },
  "categoricalExtended": {
    "blue": "#099ED8",
    "clayRed": "#CA4A50",
    "midnightGreen": "#004F61",
    "midnightPurple": "#061F5F"
  },
  "sequential": {
    "fossil": ["#5D0E1E", "#A93841", "#DF8182", "#F6C9C6"],
    "renewables": ["#015F74", "#058BB8", "#1EAEE6", "#8CD3EF"],
    "grey": ["#4C6267", "#6E8C91", "#BECCCF", "#DCE3E5"]
  },
  "map": {
    "water": "#C8D5D9",
    "land": "#F2F2EB",
    "focusCountry": "#C2C2C2",
    "focusCountryOpacity": [0.2, 0.3],
    "border": "#555555",
    "countryBorderOpacity": 0.4,
    "subnationalBorderOpacity": 0.18,
    "background": "#BECCCF"
  },
  "chart": {
    "gridline": "#CBCBCB",
    "gridlineWidth": 0.5,
    "annotationStroke": 2
  },
  "layout": {
    "maxWidth": 800,
    "pad": 28,
    "sectionGap": 32,
    "titleToSubtitle": 8,
    "legendItemGap": 16,
    "legendSwatchToLabel": 4,
    "logoHeight": 40,
    "logoMargin": 28,
    "logoColor": "#016B83"
  }
}
