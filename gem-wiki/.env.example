# Copy to gem-wiki/.env and fill in. Never commit .env (gitignored repo-wide).
#
# Create a bot password at https://www.gem.wiki/wiki/Special:BotPasswords
# (logged in as your own wiki account):
#   1. Bot name: data-ops
#   2. Grants: "Basic rights", "High-volume (bot) access",
#      "Edit existing pages" (+ "Create, edit, and move pages" if needed)
#   3. Username below is <YourWikiUsername>@data-ops; password is the
#      generated 32-character string.
GEMWIKI_USERNAME=
GEMWIKI_BOT_PASSWORD=
