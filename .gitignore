# credentials — never commit (the blanket *.json rule below also catches
# these, but keep explicit patterns in case that rule is ever loosened)
*service-account*.json
*service_account*.json
credentials.json
token.json
sheets.googleapis.com-*.json
*.pem

# nested clone of GlobalEnergyMonitor/interim-maps (its own git repo —
# never `git add` it into this one)
maps/interim-maps/

# route-lengths: the boundary layer itself is a build artifact (rebuild with
# prepare_boundaries.py, or fetch the prepped copy from Drive), but its two
# provenance sidecars are committed deliberately — they are the record of which
# EEZ/Natural Earth release the numbers came from and how every polygon was
# attributed. Negations must come after the blanket *.json / *.csv rules below.
route-lengths/*.gpkg

# added by Baird
*.csv
*.xlsx
*.xls
*.geojson
*.json
*.DS_store
*.pdf
*.png
*.eps
*.afdesign
*.afpublish

# route-lengths provenance sidecars — see the note near the top
!route-lengths/boundaries.json
!route-lengths/boundaries-attribution.csv

*.bundle.*
lib/
node_modules/
*.egg-info/
.ipynb_checkpoints
*.tsbuildinfo

